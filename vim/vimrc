" ~/.vimrc — minimal QoL config, no plugins

set nocompatible              " be iMproved (no-op if read as a vimrc)
syntax on
filetype plugin indent on

"### Sane defaults ############################################
set encoding=utf-8
set hidden                    " switch buffers without saving first
set backspace=indent,eol,start
set autoread                  " reload files changed outside Vim
set mouse=a
set ttimeoutlen=10            " kill the Esc delay (pairs with tmux escape-time)
set updatetime=300

"### Indentation ##############################################
set expandtab                 " spaces, not tabs
set tabstop=4
set shiftwidth=4
set softtabstop=4
set autoindent
set smartindent
set shiftround                " round indent to multiples of shiftwidth

"### UI #######################################################
set number
set relativenumber            " hybrid line numbers
set scrolloff=5               " keep some context around the cursor
set sidescrolloff=8
set showcmd
set wildmenu
set wildmode=longest:full,full
set laststatus=2              " always show the status line
set ruler
set nowrap
set splitbelow splitright     " open splits where you'd expect
set signcolumn=yes            " no jitter when signs appear

"### Searching ################################################
set incsearch
set hlsearch
set ignorecase
set smartcase                 " case-sensitive only if you type a capital

"### Files: keep your dirs clean ##############################
set noswapfile
set nobackup
set undofile
set undodir=~/.vim/undo//
if !isdirectory(expand('~/.vim/undo'))
  call mkdir(expand('~/.vim/undo'), 'p', 0700)
endif

"### Truecolor + clipboard (guarded for old/feature-less builds)
if has('termguicolors')
  set termguicolors
endif
if has('clipboard')
  set clipboard^=unnamed,unnamedplus
endif

"### Mappings #################################################
let mapleader = " "

" Clear search highlight
nnoremap <silent> <leader><space> :nohlsearch<CR>

" Move by visual lines when wrapping
nnoremap j gj
nnoremap k gk

" Window navigation without the C-w prefix
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l

" Keep selection after indenting in visual mode
vnoremap < <gv
vnoremap > >gv

" Quick save / reload config
nnoremap <leader>w :w<CR>
nnoremap <leader>sv :source $MYVIMRC<CR>

" Remember last cursor position when reopening a file
autocmd BufReadPost *
  \ if line("'\"") > 1 && line("'\"") <= line("$") |
  \   exe "normal! g`\"" |
  \ endif

